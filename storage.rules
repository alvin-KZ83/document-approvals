rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Encrypted document blobs. Passphrase encryption is now optional (the uploader
    // can choose to send a file unencrypted), so unlike the first version of this
    // file, access here can no longer rely on "the file is ciphertext anyway" as
    // its real protection — an unencrypted file must be gated the same way the
    // Firestore rules gate the matching /documents record. The app stamps
    // uploadedByUid/approverUid onto each object as custom metadata at upload time
    // (see index.html's uploadBytes call), so we can check identity here directly.
    match /docs/{fileName} {
      allow read: if request.auth != null
        && (resource.metadata.uploadedByUid == request.auth.uid
            || resource.metadata.approverUid == request.auth.uid);
      allow write: if request.auth != null
        && request.resource.metadata.uploadedByUid == request.auth.uid;
    }

    // Pre-uploaded e-signature images, one per user at signatures/{uid}.png.
    // These aren't sensitive the way a document is — any signed-in user may
    // need to render *someone else's* signature onto a certificate — so read
    // is open to anyone signed in. These are managed by the admin from the
    // console (same as the users collection), not uploaded from the app, but
    // write is still scoped to "only your own file" as a safety net in case
    // that ever changes.
    match /signatures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.png';
    }
  }
}

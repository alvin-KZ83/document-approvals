rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Encrypted document blobs. Kept simple for this first version: any signed-in
    // user can read/write under docs/. That's looser than the Firestore rules above
    // (which do check uploader/approver identity) — the trade-off is acceptable for
    // now because the file itself is AES-encrypted with a passphrase that only
    // approvers know, so a signed-in user who isn't the intended approver still
    // can't open it even if they find the storage path. Tightening this to match
    // the Firestore-level checks (via Cloud Functions issuing scoped access, or
    // custom claims) is a good next step once the basic flow is confirmed working.
    match /docs/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
